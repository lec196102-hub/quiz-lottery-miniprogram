.result { text-align: center; padding: 48rpx 28rpx; }
.result .big { font-size: 56rpx; font-weight: 800; }
.result.ok .big { color: var(--success); }
.result.fail .big { color: var(--danger); }
.result .score { margin-top: 16rpx; font-size: 28rpx; color: var(--text2); }
.result .tip { margin-top: 10rpx; font-size: 25rpx; color: var(--text2); }
