.head .h-title { font-size: 32rpx; font-weight: 700; }
.grid { display: flex; flex-wrap: wrap; }
.grid .m { width: 33.33%; text-align: center; padding: 16rpx 0; box-sizing: border-box; }
.grid .n { font-size: 38rpx; font-weight: 700; color: var(--primary); }
.grid .l { font-size: 22rpx; color: var(--text2); margin-top: 4rpx; }
.sec-title { font-weight: 600; margin-bottom: 12rpx; }
.pool-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid var(--border); }
.pool-row:last-child { border-bottom: none; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 4rpx; border-bottom: 1rpx solid var(--border); font-size: 30rpx; }
.menu-item:last-child { border-bottom: none; }
.menu-item .arrow { color: var(--text2); font-size: 36rpx; }
