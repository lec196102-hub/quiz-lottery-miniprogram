page {
  --primary: #185FA5;
  --primary-bg: #E6F1FB;
  --success: #3B6D11;
  --success-bg: #EAF3DE;
  --warn: #854F0B;
  --warn-bg: #FAEEDA;
  --danger: #A32D2D;
  --danger-bg: #FCEBEB;
  --text: #1a1a1a;
  --text2: #5F5E5A;
  --border: #e3e3e0;
  --bg: #f1efe8;
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}
.container { padding: 24rpx; }
.card {
  background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.btn {
  background: #fff; color: var(--text); border: 1rpx solid var(--border);
  border-radius: 14rpx; padding: 18rpx 28rpx; font-size: 28rpx;
}
.btn.primary { background: var(--primary); color: #fff; border-color: var(--primary); }
.btn.block { width: 100%; }
.btn[disabled] { opacity: .5; }
.muted { color: var(--text2); font-size: 24rpx; }
.center { text-align: center; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.gap { gap: 16rpx; }
.mt8 { margin-top: 8rpx; } .mt12 { margin-top: 12rpx; } .mt16 { margin-top: 16rpx; } .mt24 { margin-top: 24rpx; }
.badge { display: inline-block; padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; background: var(--primary-bg); color: var(--primary); }
.badge.blue { background: var(--primary-bg); color: var(--primary); }
.badge.amber { background: #FBEFD6; color: #BA7517; }
.badge.green { background: var(--success-bg); color: var(--success); }
.badge.red { background: var(--danger-bg); color: var(--danger); }
.badge.gray { background: #EFEFEA; color: var(--text2); }
.form-error { background: var(--danger-bg); color: var(--danger); border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 24rpx; margin: 16rpx 0; }
.input {
  border: 1rpx solid var(--border); border-radius: 12rpx; padding: 18rpx 20rpx;
  font-size: 28rpx; width: 100%; box-sizing: border-box;
}
.opt {
  display: block; width: 100%; text-align: left; background: #fff;
  border: 1rpx solid var(--border); border-radius: 14rpx; padding: 22rpx 24rpx;
  margin-bottom: 16rpx; font-size: 28rpx;
}
.opt.sel { border-color: var(--primary); background: var(--primary-bg); }
